# Lokalna baza z setup/docker-compose.yml
DATABASE_URL="postgres://goscinnie:goscinnie@localhost:5432/goscinnie"

# Tylko na produkcji, patrz docs/decyzje/007. Aplikacja laczy sie przez pule
# (u Supabase port 6543), a migracje bezposrednio (port 5432), bo pula w trybie
# transakcyjnym nie gwarantuje, ze cala migracja pojdzie jednym polaczeniem.
# Lokalnie zostaw pusta: zadnej puli tu nie ma.
# DATABASE_URL_MIGRACJE=""

# Sekret sesji. Lokalnie dowolny długi ciąg, produkcyjny nigdy nie trafia do repo.
BETTER_AUTH_SECRET="zmien-mnie-na-dlugi-losowy-ciag"
BETTER_AUTH_URL="http://localhost:3000"

# Adres, pod którym stoi aplikacja. Używany w sitemap.xml.
APP_URL="http://localhost:3000"

# Poczta (Resend). Lokalnie niepotrzebna: kody z maili wypisują się w konsoli.
# Na produkcji WYMAGANA: bez klucza rejestracja kończy się błędem, bo kod
# potwierdzający adres nie miałby jak dotrzeć do człowieka.
# RESEND_API_KEY="re_..."
# Nadawca widoczny w skrzynce. Domena musi być zweryfikowana w Resend.
# POCZTA_NADAWCA="Gościnnie <noreply@goscinnie.pl>"

# PayU
# PAYU_CLIENT_ID="..."
# PAYU_CLIENT_SECRET="..."
# PAYU_POS_ID="..."
# PAYU_SECOND_KEY="..."
# PAYU_NOTIFY_URL="https://twoja-domena.pl/api/webhooks/payu"
# PAYU_CONTINUE_URL="https://twoja-domena.pl/panel/platnosc/sukces"

# Lokalna baza z setup/docker-compose.yml
DATABASE_URL="postgres://goscinnie:goscinnie@localhost:5432/goscinnie"

# Tylko na produkcji, patrz docs/decyzje/007. Aplikacja laczy sie przez pule
# (u Supabase port 6543), a migracje bezposrednio (port 5432), bo pula w trybie
# transakcyjnym nie gwarantuje, ze cala migracja pojdzie jednym polaczeniem.
# Lokalnie zostaw pusta: zadnej puli tu nie ma.
# DATABASE_URL_MIGRACJE=""

# Sekret sesji. Lokalnie dowolny długi ciąg, produkcyjny nigdy nie trafia do repo.
BETTER_AUTH_SECRET="zmien-mnie-na-dlugi-losowy-ciag"
BETTER_AUTH_URL="http://localhost:3000"

# Adres, pod którym stoi aplikacja. Używany w sitemap.xml.
APP_URL="http://localhost:3000"

